# Server only. The browser never learns the backend URL; every call goes through the BFF.
API_URL=http://localhost:3000
# Server only. Shared secret the backend expects in `x-api-secret` (required in production, unset locally).
# API_SECRET=

# Public. Base URL of this deployment: metadata, canonical, sitemap, manifest.
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_CONTACT_EMAIL=ledgerflow@alexpiral.com
# Set by the deploy pipeline (tag or commit SHA); shown in Settings > About.
NEXT_PUBLIC_APP_VERSION=dev
# Optional. Feature-flag environment when it differs from NODE_ENV (the e2e build sets "test").
# NEXT_PUBLIC_APP_ENV=test

# Optional
SENTRY_DSN=
