# Server only. The browser never learns the backend URL; every call goes through the BFF.
API_URL=http://localhost:3000

# Public. Base URL of this deployment: metadata, canonical, sitemap, manifest.
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_CONTACT_EMAIL=ledgerflow@alexpiral.com
# Set by the deploy pipeline (tag or commit SHA); shown in Settings > About.
NEXT_PUBLIC_APP_VERSION=dev

# Optional
SENTRY_DSN=
