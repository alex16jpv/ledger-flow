{
  "name": "ledger-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-tokens": "node tools/check-tokens.mjs",
    "contrast-check": "node tools/contrast-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size-limit": "node tools/size-limit.mjs",
    "check-dev-routes": "node tools/check-dev-routes.mjs",
    "lighthouse": "node tools/lighthouse.mjs",
    "lighthouse:app": "node tools/lighthouse.mjs --app",
    "gen:api-types": "node tools/gen-api-types.mjs",
    "fixtures:sync": "node tools/sync-fixtures.mjs",
    "gen:feature": "plop feature",
    "build:gate": "NEXT_DIST_DIR=.next-gate SERWIST_SW_DEST=public/sw-gate.js npm run build && NEXT_DIST_DIR=.next-gate npm run size-limit && NEXT_DIST_DIR=.next-gate npm run check-dev-routes",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run check-tokens && npm run contrast-check && npm run test && npm run build:gate",
    "prepare": "lefthook install",
    "e2e:backend": "node tools/e2e-backend.mjs",
    "demo:offline": "playwright test --config=playwright.gate.config.ts tests/gate/offline-o-a.spec.ts",
    "demo:offline:watch": "DEMO_SLOW_MS=400 playwright test --config=playwright.gate.config.ts tests/gate/offline-o-a.spec.ts --project=desktop --headed",
    "demo:offline:b": "playwright test --config=playwright.gate.config.ts tests/gate/offline-o-b.spec.ts",
    "demo:offline:b:watch": "DEMO_SLOW_MS=400 playwright test --config=playwright.gate.config.ts tests/gate/offline-o-b.spec.ts --project=desktop --headed",
    "demo:offline:report": "playwright show-report playwright-report-gate",
    "measure:banner": "playwright test --config=playwright.measure.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^10.73.0",
    "@serwist/next": "^9.5.12",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "idb": "8.0.3",
    "lucide-react": "^1.39.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "openapi-typescript": "^7.13.0",
    "plop": "^4.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
